{
  "name": "project888",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u NODE_OPTIONS next dev",
    "dev:full": "npm run dev",
    "build": "next build",
    "start": "next start",
    "gmail:verify-email": "node scripts/gmail-verify-email.js",
    "migrate": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations",
